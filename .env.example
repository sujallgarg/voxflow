# VoxFlow Monorepo Environment Configuration Reference

# Backend API (apps/api/.env)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AUTH_ENFORCE=false
AUTH_SECRET=voxflow_local_dev_secret_key_32chars_min!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Frontend Web Client (apps/web/.env)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# Chrome Extension (Build time)
VOXFLOW_ENV=development
VOXFLOW_API_URL=http://localhost:3001
