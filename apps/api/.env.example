# VoxFlow API Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Token Verification
# In production, set AUTH_ENFORCE=true to reject any request lacking a valid Bearer token
AUTH_ENFORCE=false
AUTH_SECRET=voxflow_local_dev_secret_key_32chars_min!

# Supabase Server Verification (Validates user Bearer JWTs without trusting client headers)
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here
# Optional: Privileged administrative database operations ONLY. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Groq Cloud API Credentials (Required for Whisper & LLM)
GROQ_API_KEY=your_groq_api_key_here

# AI Models (Configurable, defaults to supported production models)
AI_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
