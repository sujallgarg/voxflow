# VoxFlow API Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS: In production, specify comma-separated allowed origins (e.g. https://voxflow.app,https://api.voxflow.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Groq Cloud API Credentials (Required for Whisper & LLM)
GROQ_API_KEY=your_groq_api_key_here

# AI Models (Configurable, defaults to supported production models)
AI_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
