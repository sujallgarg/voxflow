{
  "manifest_version": 3,
  "name": "VoxFlow",
  "version": "0.1.0",
  "description": "Speak naturally. Type anywhere.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "VoxFlow",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}